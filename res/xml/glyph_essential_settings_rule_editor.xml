        <EditTextPreference
            android:key="keywords"
            android:icon="@drawable/ic_match_word"
            android:title="@string/glyph_settings_essential_rule_editor_keywords_title"
            android:dialogMessage="@string/glyph_settings_essential_rule_editor_keywords_dialog_message"
            android:persistent="false"
            android:summary="%s" />

