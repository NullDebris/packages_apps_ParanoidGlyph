<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/glyph_settings_essential_rule_editor_title">

    <PreferenceCategory>

        <EditTextPreference
            android:key="name"
            android:icon="@drawable/ic_label"
            android:title="@string/glyph_settings_essential_rule_editor_name_title"
            android:persistent="false"/>

        <Preference
            android:key="packages"
            android:icon="@drawable/ic_apps"
            android:title="@string/glyph_settings_essential_rule_editor_packages_title"
            android:persistent="false"
